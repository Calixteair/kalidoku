# syntax=docker/dockerfile:1.7
# Static Astro build, served by nginx alpine.

ARG NODE_VERSION=22-bookworm-slim
ARG NGINX_VERSION=1.30-alpine3.23

FROM node:${NODE_VERSION} AS deps
WORKDIR /app/web
RUN corepack enable && corepack prepare pnpm@9.14.2 --activate
COPY web/package.json web/pnpm-lock.yaml* ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
COPY web/ ./
COPY contracts /app/contracts
RUN pnpm openapi:gen \
 && pnpm i18n:compile \
 && pnpm build

FROM nginx:${NGINX_VERSION} AS runtime
ARG GIT_REVISION=unknown
ARG IMAGE_CREATED=unknown
LABEL org.opencontainers.image.source="https://github.com/Calixteair/kalidoku" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.title="kalidoku-web" \
      org.opencontainers.image.description="kalidoku static frontend (Astro + Svelte) served by nginx." \
      org.opencontainers.image.url="https://kalidoku.calixteair.fr" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}"
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/healthz || exit 1
