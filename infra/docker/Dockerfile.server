# syntax=docker/dockerfile:1.7
# Multi-stage build for kalidoku-server.
# Final image: distroless cc-debian12:nonroot, ~30 MB.

ARG RUST_VERSION=1.88-bookworm
ARG DEBIAN_RELEASE=12

############################
# 1. cargo-chef plan
############################
FROM rust:${RUST_VERSION} AS chef
WORKDIR /work
RUN cargo install cargo-chef --locked --version 0.1.68

FROM chef AS planner
COPY Cargo.toml Cargo.lock rustfmt.toml clippy.toml rust-toolchain.toml ./
COPY core/Cargo.toml core/Cargo.toml
COPY server/Cargo.toml server/Cargo.toml
COPY worker/Cargo.toml worker/Cargo.toml
RUN mkdir -p core/src server/src worker/src \
 && echo "fn main() {}" > server/src/main.rs \
 && echo "fn main() {}" > worker/src/main.rs \
 && echo "" > core/src/lib.rs
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

############################
# 2. cargo-chef cook (cached deps)
############################
FROM chef AS builder
COPY --from=planner /work/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json -p kalidoku-server
COPY . .
RUN cargo build --release -p kalidoku-server \
 && strip target/release/kalidoku-server

############################
# 3. final image
############################
FROM gcr.io/distroless/cc-debian${DEBIAN_RELEASE}:nonroot AS runtime
ARG GIT_REVISION=unknown
ARG IMAGE_CREATED=unknown
LABEL org.opencontainers.image.source="https://github.com/Calixteair/kalidoku" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.title="kalidoku-server" \
      org.opencontainers.image.description="kalidoku backend HTTP API (Axum)." \
      org.opencontainers.image.url="https://kalidoku.calixteair.fr" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}"
WORKDIR /app
COPY --from=builder /work/target/release/kalidoku-server /usr/local/bin/kalidoku-server
# Domain packs (metadata + predicates + entities .json) so the server can
# generate solo grids on the fly via core::generator. Kept at /app/domains
# to match the worker's filesystem layout.
COPY --from=builder /work/domains /app/domains

USER nonroot
EXPOSE 8080
ENV RUST_BACKTRACE=1 \
    PORT=8080

ENTRYPOINT ["/usr/local/bin/kalidoku-server"]
