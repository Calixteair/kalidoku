---
import Base from "../../layouts/Base.astro";
import LeaderboardView from "../../lib/components/LeaderboardView.svelte";
import * as m from "../../paraglide/messages.js";
import { domainStaticPaths, findDomain } from "../../lib/domains";

export const getStaticPaths = domainStaticPaths;

const { domain } = Astro.params;
const entry = findDomain(domain!);
if (!entry) {
  return Astro.redirect("/");
}
---

<Base title={`kalidoku — leaderboard (${entry.nameFr})`}>
  <section class="flex flex-col gap-6">
    <header class="flex flex-col gap-1.5">
      <p class="eyebrow text-accent">{m.nav_leaderboard()}</p>
      <h1 class="font-display text-fg text-3xl font-semibold leading-[1.1] sm:text-4xl">
        {m.page_leaderboard_title()}<span class="text-accent">.</span>
      </h1>
      <p class="text-fg-subtle text-sm">{m.page_leaderboard_subtitle()}</p>
    </header>
    <LeaderboardView client:load domain={entry.id} />
  </section>
</Base>
