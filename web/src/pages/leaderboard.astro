---
import Base from "../layouts/Base.astro";
import LeaderboardView from "../lib/components/LeaderboardView.svelte";
import * as m from "../paraglide/messages.js";

const DEFAULT_DOMAIN = "paris-metro";
---

<Base title="kalidoku — leaderboard">
  <section class="flex flex-col gap-3">
    <h1 class="text-xl font-semibold tracking-tight md:text-2xl">{m.page_leaderboard_title()}</h1>
    <LeaderboardView client:load domain={DEFAULT_DOMAIN} />
  </section>
</Base>
