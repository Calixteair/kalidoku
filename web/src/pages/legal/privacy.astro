---
import Base from "../../layouts/Base.astro";
import * as m from "../../paraglide/messages.js";
---

<Base title="kalidoku — privacy">
  <section class="flex flex-col gap-6">
    <header class="flex flex-col gap-1.5">
      <p class="eyebrow text-accent">{m.nav_legal()}</p>
      <h1 class="font-display text-fg text-3xl font-semibold leading-[1.1] sm:text-4xl">
        {m.page_legal_privacy_title()}<span class="text-accent">.</span>
      </h1>
    </header>

    <article class="kd-prose">
      <p>{m.page_legal_privacy_intro()}</p>
      <h2>{m.page_legal_privacy_data_heading()}</h2>
      <ul>
        <li>{m.page_legal_privacy_data_item_1()}</li>
        <li>{m.page_legal_privacy_data_item_2()}</li>
        <li>{m.page_legal_privacy_data_item_3()}</li>
      </ul>
      <h2>{m.page_legal_privacy_deletion_heading()}</h2>
      <p>{m.page_legal_privacy_deletion_body()}</p>
      <h2>{m.page_legal_privacy_host_heading()}</h2>
      <p>{m.page_legal_privacy_host_body()}</p>
      <h2>{m.page_legal_privacy_contact_heading()}</h2>
      <p>
        {m.page_legal_privacy_contact_body()}
        <a href="mailto:contact@calixteair.fr">contact@calixteair.fr</a>.
      </p>
    </article>
  </section>
</Base>
