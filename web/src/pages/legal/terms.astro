---
import Base from "../../layouts/Base.astro";
import * as m from "../../paraglide/messages.js";
---

<Base title="kalidoku — terms">
  <section class="flex flex-col gap-6">
    <header class="flex flex-col gap-1.5">
      <p class="eyebrow text-accent">{m.nav_legal()}</p>
      <h1 class="font-display text-fg text-3xl font-semibold leading-[1.1] sm:text-4xl">
        {m.page_legal_terms_title()}<span class="text-accent">.</span>
      </h1>
    </header>

    <article class="kd-prose">
      <p>
        {m.page_legal_terms_intro_before_link()}
        <a href="https://github.com/Calixteair/kalidoku" rel="noopener"
          >{m.page_legal_terms_intro_link_label()}</a
        >{m.page_legal_terms_intro_after_link()}
      </p>
      <h2>{m.page_legal_terms_usage_heading()}</h2>
      <p>{m.page_legal_terms_usage_body()}</p>
      <h2>{m.page_legal_terms_ip_heading()}</h2>
      <p>{m.page_legal_terms_ip_body()}</p>
    </article>
  </section>
</Base>
