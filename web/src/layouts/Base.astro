---
import "../styles/global.css";
import { detectLocale } from "../lib/i18n.js";
import { setLanguageTag } from "../paraglide/runtime.js";
import * as m from "../paraglide/messages.js";
import Header from "../lib/components/Header.svelte";
import Footer from "../lib/components/Footer.svelte";

interface Props {
  title?: string;
  description?: string;
  /** Hide the persistent in-flow header (used by full-bleed pages). */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;

// Build-time locale (falls back to fr for static SSG). The actual runtime
// locale is set by the inline boot script below from ?lang= or the cookie,
// and the Header / Footer Svelte islands re-apply it on hydration.
const locale = detectLocale({ url: Astro.url });
setLanguageTag(locale);

const pageTitle = title ?? `${m.site_title()} — ${m.site_tagline()}`;
const pageDesc = description ?? m.site_tagline();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FAF7F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1014" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      // Apply persisted locale before SPA scripts boot.
      // Order: ?lang= URL param > locale cookie > Astro default. Paraglide reads
      // <html lang> at runtime so setting it here makes m.X() return the right tag.
      try {
        var url = new URL(window.location.href);
        var qLang = url.searchParams.get("lang");
        if (qLang === "fr" || qLang === "en") {
          document.documentElement.lang = qLang;
          document.cookie = "locale=" + qLang + "; Path=/; Max-Age=31536000; SameSite=Lax";
        } else {
          var ck = document.cookie.match(/(?:^|;\s*)locale=(fr|en)/);
          if (ck) document.documentElement.lang = ck[1];
        }
      } catch {}
      // Theme: light by default, "dark" only when the user explicitly opted in.
      // We read localStorage *before* paint to avoid the white-then-dark flash.
      try {
        if (localStorage.getItem("kalidoku.theme") === "dark") {
          document.documentElement.classList.add("dark");
        }
      } catch {}
      // Register service worker as early as possible without blocking render.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function () {});
        });
      }
    </script>
  </head>
  <body class="bg-bg text-fg flex min-h-svh flex-col">
    <a
      href="#main"
      class="bg-accent text-accent-fg sr-only rounded-md px-3 py-1.5 text-sm font-semibold focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50"
      >Skip</a
    >
    {!bare && <Header client:load />}
    <main id="main" class="mx-auto w-full max-w-screen-md flex-1 px-4 pb-12 pt-4 md:px-6 md:pt-8">
      <slot />
    </main>
    <Footer client:load />
  </body>
</html>
